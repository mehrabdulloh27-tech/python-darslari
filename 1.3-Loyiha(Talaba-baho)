def bahola(ismlar):
   baholar={}
   while ismlar:
      ism=ismlar.pop()
      baho=input(f"{ism.title()}ning bahosini kiriting: ")
      baholar[ism]=baho
   return baholar
talabalar=["bahodir", "abdugani", "jahongir", "aziz", "shavkat"]
baholar=bahola(talabalar[:])
print(baholar)
