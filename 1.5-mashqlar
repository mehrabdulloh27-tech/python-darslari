def summa(*sonlar):
   yigindi=0
   for son in sonlar:
      yigindi+=son
   return yigindi
print(summa(1,3,5,8))


def talaba_info(ism, familya, **tuliq_info):
   tuliq_info["ism"]=ism
   tuliq_info["familya"]=familya
   return tuliq_info
start=talaba_info("Abdugani", "Teshaboyev", kasbi="bojxonachi", yoshi=24, malumoti="oliy")
print(start)


def son_qush(*sonlar):
   yigindi=0
   for son in sonlar:
      yigindi+=son
   return yigindi
natija=son_qush(5, 6, 8)
print(natija) 

def num_min(*sonlar):
   return min(sonlar)
natija=num_min(5, 2, 10)
print(natija)


def num_point(text):
   return len(text)
natija=num_point("abdugani")
print(natija)


def num_type(son):
   if son%2==0:
      print(f"{son} soni juft")
   else:
      print(f"{son} soni toq")
result=num_type(25)


def mid_sum(a, b):
   return (a+b)/2
result=mid_sum(5, 2)
print(result)

def text_opp(text):
	result=''
	for letter in text:
		result=letter+result
	return result
result=text_opp('abdugani')
print(result)

def factorial_a(a):
	result=1
	for x in range(1, a+1):
		result*=x
	return result
result=factorial_a(3)
print(result)

